# Copy this file to ".env" (project root) and fill in your values:
#   cp .env.example .env        (Windows CMD: copy .env.example .env)
# The ".env" file is NOT committed (it is listed in .gitignore).

# MySQL connection (only needed when NOT using the "h2" profile)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cadastro_pessoas
DB_USER=root
DB_PASSWORD=

# Credentials of the web login (REQUIRED: the application does not start without APP_PASSWORD)
APP_USER=admin
APP_PASSWORD=change-me
